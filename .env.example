PORT=3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# sqlite (default) = one file on disk, nothing to install or run alongside.
#   This is what makes the plant deployment a plain `npm start` — no Docker,
#   no Postgres server. Internally it uses the better-sqlite3 driver; this
#   TypeORM version has no plain "sqlite" driver.
# postgres = uses the DB_HOST/DB_PORT/DB_USERNAME/DB_PASSWORD values below.
DB_TYPE=sqlite
# The mode is appended to the file name, so mock data can never end up mixed
# into real factory data: ksk_scraper-mock.sqlite / ksk_scraper-live.sqlite.
DB_NAME=ksk_scraper

# Only read when DB_TYPE=postgres.
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------------------------------------------------------------------------
# Scraper
# ---------------------------------------------------------------------------
# mock  = generated data, no network needed. Safe default.
# live  = real scraping against SITE_BASE_URL. Requires being ON the SEBN
#         network — the rework server has no route from outside.
# relay = the cloud half of the plant bridge (Railway). This server fetches
#         NOTHING: live-sync.ps1 runs on a PC inside the plant, reads the
#         pages and pushes them to POST /api/scraper/ingest. Set SYNC_SECRET.
#
# Before switching to live, run this ON the SEBN network:
#     npm run scrape:probe
# It does one search + one detail fetch, prints what it parsed, and writes
# nothing to the database. Only enable live mode once it reports PASS.
SCRAPER_MODE=mock
SITE_BASE_URL=http://rework.jenapp0001.sebn.com

# The site declares no charset. Pages are decoded by detection (strict UTF-8
# first, then windows-1252), which handled every accented French comment in
# the captured pages. Set this only to force one encoding.
# SITE_CHARSET=windows-1252

# ---------------------------------------------------------------------------
# Plant bridge (SCRAPER_MODE=relay)
# ---------------------------------------------------------------------------
# Key the plant collector (live-sync.ps1) signs every request with, using
# HMAC-SHA256 over timestamp + nonce + body. The key itself is never sent.
# Requests older than 5 minutes, replayed, or altered are rejected with a bare
# 401. At least 32 characters; with none set, every push is rejected.
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The collector asks for the same key once, at its first start, and stores it
# encrypted for that Windows account (live-sync.key). NEVER put it in
# live-sync.bat or anywhere in git.
#
# Rotation without downtime: set "old,new", give the collector the new key,
# then remove the old one. Revocation (kill switch): replace the key — the
# collector stops by itself after three refused requests.
# SYNC_SECRET=

# ---------------------------------------------------------------------------
# Dashboard sign-in (required — without both, nobody can sign in and every
# data route answers 401)
# ---------------------------------------------------------------------------
# One entry per person, name:scrypt-hash, separated by ";". Plain passwords
# are refused. Generate an entry with:   npm run auth:hash-password
# DASHBOARD_USERS=alice:scrypt$32768$8$1$...;bob:scrypt$32768$8$1$...
#
# At least 32 random characters. Signs the session cookies and socket tickets;
# changing it signs everyone out immediately.
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
# SESSION_TTL_HOURS=8

# ---------------------------------------------------------------------------
# Database on a host that injects a connection string (Railway, Render, Fly)
# ---------------------------------------------------------------------------
# When DATABASE_URL is present it wins over the DB_HOST/DB_PORT/... values
# above. TLS is enabled automatically unless the host is *.railway.internal.
# DATABASE_URL=postgresql://user:password@host:5432/railway
# DB_SSL=true
#
# Automatic schema sync at startup (needs DDL rights). Set to false once the
# schema exists and run with a role that cannot alter tables.
# DB_SYNCHRONIZE=true

# ---------------------------------------------------------------------------
# HTTP hardening (src/security/http-hardening.ts)
# ---------------------------------------------------------------------------
# Proxies in front of the app — Railway's edge is 1. A number, never "true":
# a wrong value lets clients spoof their IP through X-Forwarded-For.
# TRUST_PROXY_HOPS=1
#
# Browser origins allowed to call the API directly. Empty = none: the
# dashboard uses its same-origin /api proxy. Also restricts the live socket.
# CORS_ORIGINS=https://ksk-scraper-ashy.vercel.app
#
# Optional: only accept collector pushes from these IPs (the plant's public
# egress address). The HMAC signature is required either way.
# INGEST_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Scraper timing — defaults match the relay already running in the plant.
# Leave these alone unless the rework server is under visible strain.
# ---------------------------------------------------------------------------
# How often each model's list page is downloaded. The real page is the FULL
# history (~700 KB per model), so this is 60s in live mode.
# FAST_SCAN_INTERVAL_MS=60000

# Detail pages are fetched in throttled cycles: how often a cycle starts,
# how many pages per cycle, and the pause between two requests.
# DETAIL_CYCLE_INTERVAL_MS=30000
# MAX_DETAIL_FETCH_PER_CYCLE=250
# DETAIL_FETCH_DELAY_MS=150

# How soon a record that is still unfinished is re-checked. "Unfinished" means
# still open OR repaired but not yet released by quality control — the rework
# system closes a Rework ID in three stages (system manual §5).
# OPEN_RECHECK_MS=60000
# STALE_OPEN_RECHECK_MS=21600000

# A detail page that failed to load is retried after this long, not every cycle.
# PENDING_RETRY_MS=300000

# First run only: 0 = store the site's whole history (~6,000 records; the list
# pages are stored in seconds, then detail pages fill in over a few minutes).
# Set e.g. 30 to ingest only the last 30 days instead.
# BACKFILL_DAYS=0
